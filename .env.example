# Modelo das variáveis do Inóxio. Copie para .env (que nunca vai para o Git) e
# preencha. Na VPS, o mesmo conteúdo vai em ~/.config/inoxio/env.
INOXIO_VIRUSTOTAL_CHAVE=
INOXIO_ABUSEIPDB_CHAVE=
INOXIO_GROQ_CHAVE=
# O modelo do Groq tem padrão no código. Para testar outro, defina
# INOXIO_LLM_MODELO, INOXIO_LLM_METODO e INOXIO_LLM_ESFORCO aqui.

# Na VPS, o arquivo é ~/.config/inoxio/env (modo 600) e leva também:
# INOXIO_BANCO_URL=sqlite:////home/inoxio/dados/inoxio.db
# INOXIO_FRONTEND_DIR=/home/inoxio/frontend/atual

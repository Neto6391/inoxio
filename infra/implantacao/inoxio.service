# Unidade de usuário (systemctl --user) do app. Instalada em ~/.config/systemd/user/.
[Unit]
Description=Inóxio (app web)
After=network-online.target

[Service]
WorkingDirectory=%h/inoxio
EnvironmentFile=%h/.config/inoxio/env
ExecStart=%h/inoxio/.venv/bin/uvicorn inoxio.web.app:criar_app --factory --host 127.0.0.1 --port 8100 --no-proxy-headers --no-server-header
Restart=on-failure
RestartSec=2
# O app nunca precisa ganhar privilégio: nem sudo, nem binário setuid.
NoNewPrivileges=true

[Install]
WantedBy=default.target
